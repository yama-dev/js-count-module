{
  "name": "@yama-dev/js-count-module",
  "version": "0.4.0",
  "description": "utility that can implement count operation.\ncan flexibly count the deadline.",
  "keywords": [
    "count",
    "countup",
    "countdown",
    "utility",
    "library"
  ],
  "author": "yama-dev",
  "license": "MIT",
  "main": "./dist/js-count-module.cjs",
  "module": "./dist/js-count-module.mjs",
  "exports": {
    ".": {
      "import": "./dist/js-count-module.mjs",
      "require": "./dist/js-count-module.cjs",
      "default": "./dist/js-count-module.mjs"
    }
  },
  "unpkg": "./dist/js-count-module.global.js",
  "jsdelivr": "./dist/js-count-module.global.js",
  "scripts": {
    "start": "npm run dev",
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "test": "echo \"No tests yet\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yama-dev/js-count-module"
  },
  "bugs": {
    "url": "https://github.com/yama-dev/js-count-module/issues"
  },
  "devDependencies": {
    "esbuild": "^0.25.5",
    "eslint": "^6.2.2",
    "mocha": "^6.2.0"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "commonjs": true,
      "es6": true,
      "jquery": true,
      "node": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaFeatures": {
        "jsx": true
      },
      "ecmaVersion": 2018,
      "sourceType": "module"
    },
    "plugins": [],
    "rules": {
      "indent": [
        "error",
        2,
        {
          "outerIIFEBody": 0
        }
      ],
      "quotes": [
        "error",
        "single"
      ],
      "semi": [
        "error",
        "always"
      ],
      "no-console": "warn",
      "no-unused-vars": "warn"
    }
  }
}
